<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Namespaces stay RagAgentLab.* so splitting the project touched no source file. -->
    <RootNamespace>RagAgentLab</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample corpus travels with the library so every host (console, web) gets it.
         Content rather than None: Content items flow into the output of projects that
         reference this library, None items stop at this project. -->
    <None Remove="data\**" />
    <Content Include="data\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- Lookup tables the tools read. Not part of the searchable corpus. -->
    <None Remove="reference-data\**" />
    <Content Include="reference-data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
